# ============================================================
# Environment Variables Template - Portal CDC UM Kendari
# ============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# cp .env.example .env

# ------------------------------------------------------------
# DATABASE CONNECTION (Supabase PostgreSQL)
# ------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Untuk Supabase, gunakan Connection Pooler (Session Mode, Port 5432)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# DIRECT URL (untuk migrasi Prisma - bypass connection pooler)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------
# SUPABASE CREDENTIALS (Frontend + Backend)
# ------------------------------------------------------------
# Frontend (Vite) — HARUS pakai prefix VITE_ agar bisa diakses di browser
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="[SUPABASE_ANON_KEY]"

# Backend (Express server.js) — opsional, bisa pakai yang sama
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[SUPABASE_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SUPABASE_SERVICE_ROLE_KEY]"

# ------------------------------------------------------------
# AI / GEMINI API
# ------------------------------------------------------------
GEMINI_API_KEY="[GEMINI_API_KEY]"

# ------------------------------------------------------------
# SERVER CONFIG
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development

# JWT Secret for authentication (GENERATE A RANDOM STRING IN PRODUCTION!)
JWT_SECRET="CHANGE_THIS_TO_RANDOM_STRING_IN_PRODUCTION"

# Frontend URL for CORS (optional, defaults to localhost)
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------
# DOCKER LOCAL DATABASE (hanya untuk development lokal)
# Gunakan nilai ini jika menjalankan database via docker-compose
# ------------------------------------------------------------
# DATABASE_URL="postgresql://cdcadmin:cdcumk2026@localhost:5433/portal_cdc"
