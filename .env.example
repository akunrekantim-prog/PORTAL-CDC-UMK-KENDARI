# ============================================================
# Environment Variables Template - Portal CDC UM Kendari
# ============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# cp .env.example .env

# ------------------------------------------------------------
# DATABASE CONNECTION (Supabase PostgreSQL)
# ------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Untuk Supabase, gunakan Connection Pooler (Session Mode, Port 5432)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# DIRECT URL (untuk migrasi Prisma - bypass connection pooler)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------
# SUPABASE CREDENTIALS (Frontend + Backend)
# ------------------------------------------------------------
# Frontend (Vite) — HARUS pakai prefix VITE_ agar bisa diakses di browser
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="[SUPABASE_ANON_KEY]"

# Backend (Express server.js) — opsional, bisa pakai yang sama
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[SUPABASE_ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SUPABASE_SERVICE_ROLE_KEY]"

# ------------------------------------------------------------
# AI / GEMINI API
# ------------------------------------------------------------
GEMINI_API_KEY="[GEMINI_API_KEY]"

# ------------------------------------------------------------
# BACKEND API URL (frontend → Express API)
# ------------------------------------------------------------
# Gunakan SELALU "/api" (relative) di semua lingkungan. Yang mengarahkan /api:
#   - Dev           : vite.config.ts server.proxy → localhost:5000
#   - Testing Vercel: vercel.json rewrites → host backend testing
#   - Server kampus : nginx location /api → Node :5000
# Dengan begitu SATU build artifact yang sama dipakai di dev, testing, dan kampus
# — tidak perlu rebuild saat pindah ke server kampus.
# Mengisi URL absolut di sini akan mengikat build ke satu host.
VITE_API_URL="/api"

# ------------------------------------------------------------
# SERVER CONFIG
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development

# JWT Secret for authentication - REQUIRED in production
# Generate secure secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Example (DO NOT USE THIS - generate your own):
JWT_SECRET="0414d67ad75bb5cde1ce4fb2960bfdde87f4e18a17bd0d9b8a2c0715f8284c4389fa0fd9a359794ea981cfa328e765e924d759e53f31511ef6f2185ba000c0b7"

# Frontend URL for CORS (optional, defaults to localhost)
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------
# DOCKER LOCAL DATABASE (hanya untuk development lokal)
# Gunakan nilai ini jika menjalankan database via docker-compose
# ------------------------------------------------------------
# DATABASE_URL="postgresql://cdcadmin:cdcumk2026@localhost:5433/portal_cdc"
